<?xml version="1.0" encoding="utf-8"?>
<!--
  Where a restore of this repository is allowed to fetch from.

  Without this file the source list was assembled from whatever configuration the machine
  carried: %AppData%\NuGet\NuGet.Config, /etc, any nuget.config sitting higher in the tree, a
  feed a build agent was set up with years ago. The repository pins its actions by commit
  hash and writes each package version down exactly once, then let something outside it
  decide where those packages arrived from.

  Both <clear /> are load-bearing. Without the first, this file *adds* to the inherited feeds
  instead of replacing them. Without the second, an inherited <disabledPackageSources> can
  switch nuget.org off here, and the restore then either fails or resolves somewhere else.

  What is deliberately not here is a lock file. Verifying the resolved graph by fingerprint
  means restoring in locked mode, which means a flag on every build invocation in the two
  workflows and in verify.ps1, and a lock that drifts then turns a commit that changed
  nothing red. That is the failure mode global.json argues against at length about the SDK
  pin, in the same words, and the graph a lock would fingerprint here is one third-party
  package carrying no dependencies of its own.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <!-- One source and one pattern, so the mapping is satisfied today and a second source
       added later cannot resolve anything until someone writes down what it may serve. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
