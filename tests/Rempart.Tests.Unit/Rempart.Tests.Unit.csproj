<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rempart.Tests.Unit</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- These tests run off Windows: they only touch Rempart.Core. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- Coverage collector, test-only: developmentDependency, no compile-time reference,
         nothing reaches the shipped binary. Versions live in Directory.Packages.props;
         this metadata does not, because central management moves the version and nothing
         else — declared there it would be dropped, and the collector would become a public
         transitive dependency of the test assembly. -->
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rempart.Core\Rempart.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
